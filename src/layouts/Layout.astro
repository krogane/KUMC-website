---
import '../styles/global.css';
import {cspPolicy} from '../lib/csp.mjs';
import { site } from '../data/site';
import {safeJson} from '../lib/schema.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
interface Props {title:string;description?:string;image?:string;imageAlt?:string;noindex?:boolean;article?:{publishedAt:string;updatedAt?:string};breadcrumbs?:{name:string;url:string}[]}
const {title,description=site.description,image='/og/default.jpg',imageAlt='京大マインクラフト同好会KUMCの京大再現マップ',noindex=false,article,breadcrumbs=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
const graph:Record<string,unknown>[]=[{'@type':'Organization','@id':`${site.url}/#organization`,name:site.name,url:site.url,email:site.email,sameAs:[site.x,site.blog,site.colony]},{'@type':'WebSite','@id':`${site.url}/#website`,name:site.name,url:site.url,inLanguage:'ja',publisher:{'@id':`${site.url}/#organization`}}];
if(breadcrumbs.length)graph.push({'@type':'BreadcrumbList',itemListElement:[{name:'トップ',url:'/'},...breadcrumbs].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,site.url).href}))});
if(article)graph.push({'@type':'Article',headline:title,description,datePublished:article.publishedAt,dateModified:article.updatedAt||article.publishedAt,author:{'@id':`${site.url}/#organization`},publisher:{'@id':`${site.url}/#organization`},image:new URL(image,site.url).href,mainEntityOfPage:canonical});
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta http-equiv="Content-Security-Policy" content={cspPolicy()}/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="description" content={description}/><meta name="theme-color" content="#246B45"/><meta name="robots" content={!site.production||noindex?'noindex, nofollow':'index, follow'}/><title>{title==='トップ'?site.name:`${title} | ${site.name}`}</title><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="KUMCのお知らせ" href="/rss.xml"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title==='トップ'?site.name:title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,site.url).href}/><meta property="og:image:alt" content={imageAlt}/><meta property="og:locale" content="ja_JP"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@KUMC_X"/><meta name="twitter:title" content={title==='トップ'?site.name:title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,site.url).href}/><meta name="twitter:image:alt" content={imageAlt}/><script type="application/ld+json" set:html={safeJson({'@context':'https://schema.org','@graph':graph})}/></head>
<body data-site-url={site.url} data-analytics-enabled={String(site.analyticsEnabled)} data-measurement-id={site.measurementId}><a class="skip-link" href="#main">本文へスキップ</a><Header/><main id="main" tabindex="-1"><slot/></main><Footer/><Consent/><script src="/scripts/site.js" type="module" is:inline></script></body></html>
