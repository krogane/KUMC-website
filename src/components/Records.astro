---
import type {CollectionEntry} from 'astro:content';
import {dateLabel} from '../lib/content';
import Arrow from './Arrow.astro';
interface Props{entries:CollectionEntry<'achievements'>[]}
const {entries}=Astro.props;
---
<ul class="record-list">{entries.map(({data:d})=><li><a class="record-link" href={`/achievements/${d.slug}/`}><time datetime={d.eventDate}>{dateLabel(d.eventDate)}</time><div><h3>{d.title}</h3><p>{d.summary}</p></div><Arrow/></a></li>)}</ul>
