---
const themes = [
  { value: 'auto', label: '自動（端末の設定）', path: 'M4 3h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1ZM8 21h8M12 17v4' },
  { value: 'light', label: 'ライトモード', path: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M5 19l1.5-1.5M17.5 6.5 19 5' },
  { value: 'dark', label: 'ダークモード', path: 'M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7Z' },
];
---
<div class="theme-control" data-theme-control hidden>
  <span aria-hidden="true">表示テーマ</span>
  <div class="theme-options" role="group" aria-label="表示テーマ">
    {themes.map(({value, label, path}) => (
      <button type="button" data-theme-value={value} aria-label={label} title={label} aria-pressed="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg>
      </button>
    ))}
  </div>
</div>
