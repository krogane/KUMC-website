---
import { nav } from '../data/site';
import ThemeControl from './ThemeControl.astro';
const current = Astro.url.pathname;
---
<header class="site-header"><div class="container header-inner">
<a href="/" class="brand"><span class="wordmark">KUMC</span><span class="brand-name">京大マインクラフト<br/>同好会</span></a>
<details class="mobile-menu"><summary aria-label="メニュー" aria-controls="mobile-navigation"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary><nav id="mobile-navigation" aria-label="モバイルナビゲーション">{nav.map(([url,label])=><a href={url} aria-current={current.startsWith(url)?'page':undefined}>{label}</a>)}<a href="/contact/">お問い合わせ</a><ThemeControl/></nav></details>
<nav class="desktop-nav" aria-label="メインナビゲーション">{nav.map(([url,label])=><a href={url} class:list={{'nav-join':url==='/join/','nav-contact':url==='/collaboration/'}} aria-current={current.startsWith(url)?'page':undefined}>{label}</a>)}<ThemeControl toggle/></nav>
</div></header>
