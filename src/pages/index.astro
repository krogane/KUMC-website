---
import {Image} from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import Records from '../components/Records.astro';
import Arrow from '../components/Arrow.astro';
import Feed from '../components/Feed.astro';
import XEmbed from '../components/XEmbed.astro';
import Invitation from '../components/Invitation.astro';
import {published} from '../lib/content';
import heroImage from '../assets/campus-panorama.jpg';
import activities from '../data/activities.json';
import {site} from '../data/site';
const all=await published('works');const works=['kyoto-campus','treasure-run','gunfight'].map(id=>all.find(w=>w.data.slug===id)).filter((w):w is NonNullable<typeof w>=>Boolean(w));
const records=await published('achievements');
---
<Layout title="トップ"><section class="hero" aria-label="KUMCの紹介"><Image class="hero-image" src={heroImage} alt="Minecraftで再現した京都大学の時計台と周囲の建物" widths={[390,768,1200]} sizes="(max-width: 995px) 996px, 100vw" format="webp" loading="eager" fetchpriority="high"/><div class="container hero-content"><h1><span>「あそぶ」+「つくる」</span><span>の可能性を広げる。</span></h1><div class="actions"><a class="button" href="/join/">入会方法を見る <Arrow/></a><a class="button secondary" href="/works/">作品を見る <Arrow/></a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>KUMCが制作してきた作品</h2><a class="text-link" href="/works/">すべての作品を見る <Arrow/></a></div><div class="works-grid">{works.map(work=><WorkCard work={work} hidePublished/>)}</div></div></section>
<section class="section white"><div class="container activity-grid"><div class="activity-intro"><p class="section-label">OUR ACTIVITIES</p><h2>遊びたいときに<br/>一緒に遊べる誰かがいる。</h2><p>Minecraftで遊び、創作し、交流する。<br/>KUMCは、一人ひとりの関心や得意を持ち寄って活動するサークルです。学業や仕事と両立しながら、無理のないペースで参加できます。</p><a class="text-link" href="/activities/">活動内容を見る <Arrow/></a></div><ol class="activity-rows">{activities.map((a,i)=><li><span class="activity-number" aria-hidden="true">0{i+1}</span><div><h3>{a.title}</h3><p>{a.text}</p></div></li>)}</ol></div></section>
<section class="section"><div class="container"><div class="section-head"><div><p class="section-label">ACTIVITY LOG</p><h2>これまでの活動記録</h2></div><a class="text-link" href="/achievements/">すべての実績を見る <Arrow/></a></div><Records entries={records}/></div></section>
<section class="section white"><div class="container news-columns"><div><div class="section-head"><h2>最新情報</h2><a class="text-link" href="/news/">ニュース一覧 <Arrow/></a></div><Feed source="blog" limit={site.feedLimits.home} showSource={false}/></div><XEmbed/></div></section><Invitation/></Layout>
