---
import {Image} from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import Records from '../components/Records.astro';
import Arrow from '../components/Arrow.astro';
import Feed from '../components/Feed.astro';
import XEmbed from '../components/XEmbed.astro';
import Invitation from '../components/Invitation.astro';
import {published,dateLabel} from '../lib/content';
import {images} from '../lib/images';
import activities from '../data/activities.json';
import {site} from '../data/site';
const all=await published('works');const works=['kyoto-campus','treasure-run','gunfight'].map(id=>all.find(w=>w.data.slug===id)).filter((w):w is NonNullable<typeof w>=>Boolean(w));
const records=await published('achievements');const news=await published('news');
---
<Layout title="トップ"><section class="container hero"><div><h1><span>Minecraftで、</span><span>遊び、つくり、</span><span>つながる。</span></h1><p>京大マインクラフト同好会KUMCです。<br/>遊びも、ものづくりも。<br/><span class="hero-ending">一人ひとりの好きから、新しい世界が広がります。</span></p><div class="actions"><a class="button" href="/join/">入会方法を見る <Arrow/></a><a class="button secondary" href="/works/">作品を見る <Arrow/></a></div></div><figure class="hero-media"><Image src={images.campus} alt="Minecraftで再現した京都大学の時計台" widths={[320,480,600]} sizes="(max-width: 767px) calc(100vw - 40px), 600px" format="webp" loading="eager" fetchpriority="high"/><figcaption>京大再現マップ — KUMC制作</figcaption></figure></section>
<div class="container rainbow"></div>
<section class="section"><div class="container"><div class="section-head"><h2>私たちがつくる世界。</h2><a class="text-link" href="/works/">すべての作品を見る <Arrow/></a></div><div class="works-grid">{works.map(work=><WorkCard work={work}/>)}</div></div></section>
<section class="section white"><div class="container activity-grid"><div class="activity-intro"><p class="section-label">OUR ACTIVITIES</p><h2>好きなことが、<br/>活動になる。</h2><p>Minecraftで遊び、創作し、交流する。<br/>KUMCは、一人ひとりの関心や得意を持ち寄って活動するサークルです。学業や仕事と両立しながら、無理のないペースで参加できます。</p><a class="text-link" href="/activities/">活動内容を見る <Arrow/></a></div><ol class="activity-rows">{activities.map((a,i)=><li><span class="activity-number" aria-hidden="true">0{i+1}</span><div><h3>{a.title}</h3><p>{a.text}</p></div></li>)}</ol></div></section>
<section class="section"><div class="container"><div class="section-head"><div><p class="section-label">ACTIVITY LOG</p><h2>活動の記録。</h2></div><a class="text-link" href="/achievements/">すべての実績を見る <Arrow/></a></div><Records entries={records}/></div></section>
<section class="section white"><div class="container news-columns"><div><div class="section-head"><h2>最新情報</h2><a class="text-link" href="/news/">ニュース一覧 <Arrow/></a></div>{news.length>0&&<><p class="feed-source">KUMCのお知らせ</p><ul class="news-list">{news.slice(0,2).map(n=><li><a href={`/news/${n.data.slug}/`}><time datetime={n.data.publishedAt}>{dateLabel(n.data.publishedAt)}</time><span class="news-title">{n.data.title}</span></a></li>)}</ul></>}<Feed source="blog" limit={site.feedLimits.home}/></div><XEmbed/></div></section><Invitation/></Layout>
