---
import Page from '../../layouts/Page.astro';
import MagazineShopLink from '../../components/MagazineShopLink.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import '../../styles/content-pages.css';
import {nf2026} from '../../data/nf2026';
const sections = [
  ['meetings', 'オンライン例会'], ['hypixel', 'Hypixel'], ['nf', '11月祭への出展'],
  ['making', 'ゲーム・マップ制作'], ['education', '教育支援'], ['beyond', 'Minecraft以外の活動'],
];
---
<Page title="活動内容" label="ACTIVITIES" description="週に一度の例会から11月祭の出展まで、KUMCの活動を紹介します。" wide>
  <nav class="content-nav" aria-label="活動内容の目次">{sections.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}</nav>

  <section id="meetings" class="content-section">
    <div class="content-split">
      <div class="content-copy">
        <h2>オンライン例会</h2>
        <p>Discordのボイスチャットに集まり、サバイバル、建築、自作ミニゲーム、配布マップなどを遊びます。企画はメンバーが持ち寄り、内容に合わせてゲームサーバーを用意します。</p>
        <p>週1回の開催を基本に、試験期などは休会します。開催曜日・開始時刻・対応するMinecraftの版は回ごとに異なるため、Discordのお知らせとイベントで案内しています。参加は任意で、途中退出もできます。</p>
        <div class="activity-log">
          <h3>2026年に遊んだ企画</h3>
          <ul>
            <li><time datetime="2026-05-09">5月9日</time>3時間以内にウィザーを倒し、最大サイズのビーコンを作るサバイバル。</li>
            <li><time datetime="2026-06-21">6月21日</time>建築する番と、お題を推測する番を交互に繰り返す建築伝言ゲーム。</li>
            <li><time datetime="2026-07-11">7月11日</time>Create Modを使ったサバイバル。</li>
            <li><time datetime="2026-10-03">10月3日</time>キラーエスケープ・人狼クエスト・ゴールドラッシュ。</li>
          </ul>
        </div>
      </div>
      <div>
        <Photo image="meeting" alt="KUMCの自作ゲーム「本格マイクラ銃撃戦」をメンバーでプレイしている画面" eager />
        <div class="activity-log content-copy">
          <h3>他団体との合同企画</h3>
          <p>麻布Minecraft同好会とは自作ミニゲームや人狼で交流。2026年8月22日の合同企画会では、京大トレジャーラン・銃撃戦・サバイバルBINGOなどを実施しました。9月26日には山梨大学Minecraftサークルの建築伝言ゲームを遊びました。</p>
          <a class="text-link" href="/achievements/#exchange">交流の実績を見る <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="hypixel" class="content-section content-copy">
    <div class="content-split">
      <div>
        <h2>Hypixel</h2>
        <p>Java版Minecraftのマルチプレイサーバー「Hypixel」でも遊んでいます。例会ではBedWarsなどの対戦ゲームをプレイし、メンバー間ではSkyBlockのように継続して遊ぶゲームも楽しまれています。</p>
        <h3>BedWars</h3>
        <p>自分のチームのベッドを守りながら、相手のベッドを壊すチーム対戦。KUMCでは4人ずつの4チームで戦うモードなどを遊びます。</p>
        <h3>SkyBlock</h3>
        <p>装備を集めてキャラクターを育成し、島々やダンジョンを攻略するゲームです。</p>
        <a class="text-link" href="https://hypixel.net/" target="_blank" rel="noopener noreferrer">Hypixel公式サイト <Arrow external /></a>
      </div>
      <Photo image="hypixel" alt="KUMCの紹介ページに掲載されたHypixelのロビーのプレイ画面" caption="Hypixelのロビー。ここから各ミニゲームに参加します。" />
    </div>
    <div class="photo-pair">
      <Photo image="bedwars" alt="BedWarsの4チームの拠点と中央の島" caption="BedWars：チームの拠点を足場でつなぎ、相手のベッドを目指します。" />
      <Photo image="skyblock" alt="Hypixel SkyBlockに登場する島々" caption="SkyBlock：探索・育成・ダンジョン攻略の舞台となる島々。" />
    </div>
  </section>

  <section id="nf" class="content-section content-split">
    <div class="content-copy">
      <h2>11月祭（NF）への出展</h2>
      <p>京都大学の学園祭「11月祭（NF）」に、2024年・2025年に屋内出展しました。会場ではKUMCが作ったゲームを来場者が実際に操作し、私たちの建築や会報誌を手に取れる形で展示・紹介しました。</p>
      <h3>2025年の出展内容</h3>
      <ul>
        <li>京大トレジャーラン・本格マイクラ銃撃戦の体験</li>
        <li>京大再現キャンパスの観覧、建築写真の展示</li>
        <li>会報誌「KU匠 vol.2」の販売</li>
        <li>紙のブロックを作るペーパークラフト</li>
        <li>エンドラRTA軍団によるRTA実演・実況解説</li>
        <li>Minecraftの英訳・和訳クイズ、豆知識などの展示</li>
      </ul>
      <a class="text-link" href="/achievements/nf-2025/">2025年の出展を詳しく見る <Arrow /></a>
    </div>
    <Photo image="nf-crowd" alt="2025年11月祭のKUMC出展で、教室内のスクリーンを見る来場者" caption="2025年11月祭のKUMC出展。会場でゲーム体験やRTA実演を行いました。" />
  </section>

  <section id="making" class="content-section content-split">
    <div class="content-copy">
      <h2>ゲーム・マップ制作</h2>
      <p>京都大学吉田キャンパスの再現建築をはじめ、宝探し、銃撃戦、アスレチック、サバイバルBINGOなどを制作しています。完成したゲームは例会や新歓、11月祭で使用し、一部は配布サイトで公開しています。</p>
      <p>建築、コマンド・データパック、テクスチャ、ゲームルールの設計をメンバーで分担して製作しています。京大再現マップでは、実際のキャンパスで撮影した写真や航空写真、地理院地図を参考に、約半年かけて建物を再現しました。</p>
      <a class="text-link" href="/works/">作品と遊び方を見る <Arrow /></a>
    </div>
    <Photo image="campus-wide" alt="KUMCがMinecraftで再現した京都大学の時計台と広場" />
  </section>

  <section id="education" class="content-section">
    <div class="content-copy">
      <h2>教育支援事業の運営・制作</h2>
      <p>子どもたちがMinecraftの中で課題を見つけ、解決策を作るワークショップを企画・運営しています。</p>
    </div>
    <div class="game-list content-copy">
      <article>
        <h3>マイクラ防災キャンプ2026</h3>
        <p>2026年8月8日、京都経済センターKOINでKyoto AI×Edu Labと開催。地震・洪水・火災など8種類の課題を用意し、小中学生が危険の発見から対策の制作、発表まで取り組みました。</p>
        <a class="text-link" href="/achievements/bosai-camp-2026/">開催内容を見る <Arrow /></a>
      </article>
      <article>
        <h3>京都学び育みマルシェ2026</h3>
        <p>2026年9月5日、防災プログラムを20分の体験版として出展。高い建物のある街と川が流れる町の2つのステージで、危険を探して安全に作り直す体験を行いました。</p>
        <a class="text-link" href="/achievements/manabi-marche-2026/">体験プログラムを見る <Arrow /></a>
      </article>
    </div>
    <div class="book-feature content-section">
      <Photo image="ku-takumi-vol3" alt="KUMCの会報誌「KU匠 Vol.3」の表紙" contain />
      <div class="content-copy">
        <h3>会報誌「KU匠」の販売</h3>
        <p>2026年の新刊は「KU匠 Vol.3」。テーマは「マイクラ×学び」です。{nf2026.onsite.magazine.description}</p>
        <p>記事の執筆、誌面のデザイン、編集もメンバーが担当し、11月祭などで販売しています。</p>
        <p><MagazineShopLink /></p>
        <a class="text-link" href="/works/#publication">会報誌について見る <Arrow /></a>
      </div>
    </div>
  </section>

  <section id="beyond" class="content-section content-split">
    <div class="content-copy">
      <h2>Minecraft以外の活動</h2>
      <h3>サーバー管理とAI開発</h3>
      <p>Minecraftサーバーの管理に加えて、Discordからサークルの資料やチャット履歴について質問できるAIチャットボット「KUMC-Agent」を開発しています。</p>
      <h3>対面での交流</h3>
      <p>2026年5月29日には大文字山への登山、6月26日にはカラオケの対面例会を開催しました。オンライン以外にも、メンバー同士で集まる機会があります。</p>
    </div>
    <div class="content-copy">
      <h3>京大ゲーム部との生活サーバー</h3>
      <p>京大ゲーム部と共同で、バニラサバイバルをベースにした生活サーバーを運営しています。</p>
    </div>
  </section>
</Page>
