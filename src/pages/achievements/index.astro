---
import Page from '../../layouts/Page.astro';import Records from '../../components/Records.astro';import {published} from '../../lib/content';
const all=(await published('achievements')).sort((a,b)=>b.data.eventDate.localeCompare(a.data.eventDate));const years=[...new Set(all.map(a=>a.data.eventDate.slice(0,4)))];
---
<Page title="活動実績" label="ACTIVITY LOG" description="つくったものを、誰かに届ける。展示・体験企画や共同制作など、これまでの活動を記録しています。" wide>{years.map(year=><section class="year-group"><h2>{year}</h2><Records entries={all.filter(a=>a.data.eventDate.startsWith(year))}/></section>)}<a class="text-link" href="/collaboration/">制作・共同企画について相談する →</a></Page>
