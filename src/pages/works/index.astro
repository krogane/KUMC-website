---
import Page from '../../layouts/Page.astro';
import WorkCard from '../../components/WorkCard.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import { published } from '../../lib/content';
import '../../styles/content-pages.css';
const works = await published('works');

const otherGames = [
  { title: '建築しりとり', text: '前の人の建築が何を表しているかを読み取り、その言葉の最後の文字から始まるものを建築する、Minecraft版の絵しりとり。', url: 'https://kumc.hatenablog.com/entry/2025/05/30/183922' },
  { title: '建築伝言ゲーム', text: 'お題をブロックで表現する番と、建築を見てお題を推測する番を交互に繰り返すゲーム。' },
  { title: 'ランダムダンジョン', text: 'ランダム生成された地形を進み、強化されたモンスターと戦いながらダンジョンの踏破を目指すミニゲーム。' },
  { title: '動物となかよく', text: '動物を守りながらゴールを目指すrunnerと、動物を狙うhunterの2チームに分かれて対戦するミニゲーム。' },
  { title: '逢魔攻戦記', text: 'ウェーブごとに迫ってくる感染者と戦うPvEミニゲーム。次々に出現する敵を迎え撃ちます。' },
];
---
<Page title="作品" label="OUR WORKS" description="京都大学の再現マップ、キャンパスで遊ぶ宝探しやアスレチック、対戦ミニゲーム、会報誌。KUMCが制作した作品を紹介します。" wide>
  <nav class="content-nav" aria-label="作品の目次"><a href="#downloads">配布中のマップ</a><a href="#minigames">例会・イベントのミニゲーム</a><a href="#publication">会報誌「KU匠」</a></nav>
  <section class="work-overview content-split content-copy" aria-labelledby="campus-heading">
    <Photo image="campus-wide" alt="Minecraftで再現した京都大学の時計台と広場" eager />
    <div>
      <h2 id="campus-heading">京大再現キャンパス</h2>
      <p>京都大学吉田キャンパスの本部構内を、実際に撮影した写真や航空写真、地理院地図をもとに約半年かけて再現しました。時計台や校舎、広場をMinecraftの中で歩けます。</p>
      <p>建築ワールドはJava版・統合版で配布。このキャンパスは「京大トレジャーラン」「京大アスレチック」の舞台にもなっています。</p>
      <a class="text-link" href="/works/kyoto-campus/">再現マップの詳細・ダウンロード <Arrow /></a>
    </div>
  </section>

  <section id="downloads" class="content-section">
    <h2 class="catalog-heading">配布中のマップ</h2>
    <div class="works-grid large">{works.map(work => <WorkCard work={work} heading="h3" showDetails hideMetadata />)}</div>
  </section>

  <section id="minigames" class="content-section">
    <h2 class="catalog-heading">例会・イベントのミニゲーム</h2>
    <p class="catalog-intro">新歓、例会、他団体との合同企画のためにもゲームを作っています。ここでは実際のルールと、プレイの様子を紹介します。</p>
    <div class="mini-game-grid">
      <article class="content-copy">
        <Photo image="bingo" alt="エンドラRTA軍団とのコラボで使用した5×5の謎解きBINGOカード" caption="謎解きBINGOの問題カード。各マスがMinecraft内の課題を表しています。" contain />
        <h3>サバイバルBINGO</h3>
        <p>サバイバルで指定された課題を達成し、ビンゴを狙うゲーム。エンドラRTA軍団とのコラボでは、5×5のカードに書かれたクイズや謎を解き、対応する行動をMinecraft内で実行する「謎解きBINGO」で対戦しました。</p>
        <a class="text-link" href="https://kumc.hatenablog.com/entry/2025/11/01/193054" target="_blank" rel="noopener noreferrer">謎解きBINGOの解説を読む <Arrow external /></a>
      </article>
      <article class="content-copy">
        <Photo image="blockhide" alt="本棚やブロックが並ぶBLOCK HIDEのかくれんぼステージ" />
        <h3>BLOCK HIDE</h3>
        <p>ブロックに変身して風景に紛れるhiderと、それを見つけるseekerに分かれるかくれんぼ。隠れる場所の選び方と、風景の違和感を見つける観察力が勝負になります。</p>
        <a class="text-link" href="https://kumc.hatenablog.com/entry/2025/05/20/160000" target="_blank" rel="noopener noreferrer">企画紹介を読む <Arrow external /></a>
      </article>
    </div>
    <div class="game-list">{otherGames.map(game => <article><h3>{game.title}</h3><p>{game.text}</p>{game.url && <a class="text-link" href={game.url} target="_blank" rel="noopener noreferrer">企画紹介を読む <Arrow external /></a>}</article>)}</div>
    <div class="photo-pair">
      <Photo image="meeting" alt="メンバーがKUMC制作の銃撃戦マップで対戦している様子" />
      <Photo image="azabu" alt="麻布Minecraft同好会と京大トレジャーランで遊んでいる様子" />
    </div>
  </section>

  <section id="publication" class="content-section book-feature">
    <Photo image="ku-takumi-vol3" alt="会報誌「KU匠 Vol.3」の表紙" contain />
    <div class="content-copy">
      <h2>会報誌「KU匠」</h2>
      <p>KUMCの活動紹介、京大再現マップやメンバーの建築写真、Minecraftの技術解説をまとめた会報誌です。記事の執筆から編集・誌面デザインまでメンバーで制作しています。</p>
      <ul>
        <li><strong>2026年「KU匠 Vol.3」：</strong>テーマは「マイクラ×学び」。スティーブの能力を科学で考える記事や、翻訳・プログラミングなどを紹介する新刊です。</li>
        <li><strong>2025年「KU匠 vol.2」：</strong>フルカラーで制作。レッドストーンを使う論理回路、コマンド、エンドラRTAなどの解説を収録しました。</li>
        <li><strong>2024年「KU匠」：</strong>初めての11月祭出展に合わせて制作。再現建築やメンバーの記事を収録しました。</li>
      </ul>
      <a class="text-link" href="/nf/2026/#nf-magazine-title">Vol.3の紹介を見る <Arrow /></a>
      <a class="text-link" href="https://kumc.hatenablog.com/entry/2025/05/28/154315" target="_blank" rel="noopener noreferrer">初号の紹介記事を読む <Arrow external /></a>
      <a class="text-link" href="/achievements/nf-2025/">vol.2を販売した11月祭の記録 <Arrow /></a>
    </div>
  </section>
</Page>
