{
  "name": "kumc-official-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.23.3" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "feeds": "node scripts/fetch-feeds.mjs",
    "build": "node scripts/validate-content.mjs && astro build && node scripts/verify-dist.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "audit:performance": "node scripts/lighthouse.mjs"
  }
}
